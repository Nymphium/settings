font-family = MonaspiceNe Nerd Font Mono
font-family = Source Han Sans VF
font-size = 13
# CoreText draws thinner than WezTerm did; 0-255, raise for bolder strokes
font-thicken = true
font-thicken-strength = 128
# https://monaspace.githubnext.com/#code-ligatures
font-feature = ss01
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09
font-feature = ss10
font-feature = cv01=2
font-feature = cv02
font-feature = cv10
font-feature = cv11
font-feature = cv30
font-feature = cv31
font-feature = cv32
font-feature = cv62
font-feature = liga
font-feature = calt
font-feature = case

theme = light:TokyoNight Day,dark:TokyoNight Storm

window-padding-x = 3
# top, bottom
window-padding-y = 0,2

# herdr's keys are all alt+..., so Option must reach it as Alt
macos-option-as-alt = true
# the defaults turn alt+left/right into esc b / esc f, and esc b is alt+b, herdr's prefix
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind
# herdr cannot bind PageUp/PageDown, so relay tab switching/moving as F13-F16 (kitty CSI u)
keybind = ctrl+page_up=csi:57376u
keybind = ctrl+page_down=csi:57377u
keybind = ctrl+shift+page_up=csi:57378u
keybind = ctrl+shift+page_down=csi:57379u

keybind = ctrl+v=paste_from_clipboard
