#!/usr/bin/env zsh
# Run by dark-notify with "light" or "dark" on macOS appearance changes.
# herdr forwards the color scheme report to panes before it has re-queried the host colors,
# so Cursor CLI re-detects the old background; resend the report once herdr has caught up.
set -euo pipefail

herdr=/opt/homebrew/bin/herdr
jq=/opt/homebrew/bin/jq

case "${1-}" in
  (dark) report=$'\e[?997;1n' ;;
  (light) report=$'\e[?997;2n' ;;
  (*) print -u2 "usage: ${0:t} light|dark"; exit 2 ;;
esac

sleep 1
# only panes running Cursor CLI, which enables mode 2031; a shell would take the report as typed text
for pane in $($herdr agent list | $jq -r '.result.agents[] | select(.agent == "cursor") | .pane_id'); do
  $herdr pane send-text "$pane" "$report" >/dev/null
done
